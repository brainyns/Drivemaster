# Copia este archivo a .env y completa los valores reales.
# .env NO se sube a git. Este ejemplo es la referencia para Render/Supabase/Atlas.

# ── PostgreSQL (Supabase en produccion) ──
# Local:   jdbc:postgresql://localhost:5432/drivemaster_config
# Supabase: jdbc:postgresql://db.XXXXXXXX.supabase.co:5432/postgres?sslmode=require
DB_URL=jdbc:postgresql://localhost:5432/drivemaster_config
DB_USERNAME=postgres
DB_PASSWORD=CONTRASENA

# ── MongoDB Atlas ──
SPRING_DATA_MONGODB_URI=mongodb+srv://USUARIO:CONTRASENA@CLUSTER.mongodb.net/drivemasterDB?retryWrites=true&w=majority

# ── JWT (generar uno largo y aleatorio) ──
SECURITY_JWT_SECRET=SECRETO_LARGO_ALEATORIO_DE_32_CARACTERES_O_MAS



# ── Correo (Brevo) ──
# Clave de la API de Brevo (empieza por xkeysib-). Sin ella no se envía ningún correo.
BREVO_API_KEY=TU_API_KEY_DE_BREVO
# Remitente: DEBE estar verificado en Brevo (Remitentes, dominios e IP > Remitentes).
# Un Gmail sin verificar es rechazado por Brevo. Si no se define se usa SPRING_MAIL_USERNAME.
BREVO_SENDER_EMAIL=remitente-verificado@tudominio.com
BREVO_SENDER_NAME=DriveMaster
# SOLO desarrollo local. En Render/producción no definir ninguna de las dos.
# true = escribe en el log del backend el asunto y el destinatario de cada correo y SIGUE enviando.
# Con llaves pub_test_ de Wompi escribe además el código de retiro de los pedidos (nunca en pantalla ni en la API).
MAIL_DEV_LOG=false
# true = no envía ningún correo (independiente de la anterior).
MAIL_DEV_SKIP_SEND=false
# URL pública (https) del logo para el encabezado de los correos y del PDF (p. ej. la imagen subida a Brevo).
# Si se deja vacía, los correos y el PDF muestran el nombre "DriveMaster" (a la derecha del logo cuando hay logo).
BRAND_LOGO_URL=
# Ancho del logo en el correo, en px (por defecto 160). Con una imagen recortada sin margen, unos 80.
BRAND_LOGO_WIDTH=160

# ── Código de retiro ──
# Clave secreta del servidor (HMAC-SHA256) con la que se guardan los códigos de retiro. Larga y aleatoria
# (mín. 32 caracteres), por ejemplo: openssl rand -hex 32. OBLIGATORIA con llaves de Wompi de producción (no
# pub_test_): sin ella el backend no arranca. En desarrollo solo avisa. Si se cambia,
# los códigos emitidos con la anterior dejan de validar (el cliente puede pedir uno nuevo). Los emitidos antes
# del HMAC siguen validando.
RETIRO_CODIGO_SECRET=

# ── Migración de compras y proveedores sin dueño (una sola vez; ver drivemaster/MIGRACIONES_PENDIENTES.md) ──
# Haz un respaldo antes. Apagada por defecto: no definir estas variables en el día a día.
# MIGRAR_COMPRAS_PROVEEDORES=true
# MIGRAR_COMPRAS_PROVEEDORES_TIENDA=id o nombre exacto de la tienda destino
# MIGRAR_COMPRAS_PROVEEDORES_SIMULAR=true   (solo cuenta, no escribe)

# ── Limpieza de la antigua "Tienda DriveMaster" (una sola vez; ver drivemaster/MIGRACIONES_PENDIENTES.md) ──
# BORRA sus productos, sus movimientos de inventario y el registro de la tienda. Haz un respaldo antes y corre
# primero la simulación (solo cuenta). Apagada por defecto: no definir estas variables en el día a día.
# MIGRAR_LIMPIEZA_TIENDA_PROPIA=true
# MIGRAR_LIMPIEZA_TIENDA_PROPIA_SIMULAR=true   (informe previo: no borra nada)

# ── n8n (chat IA) ──
# El chat lo atiende un agente orquestado en n8n (modelo vía OpenRouter). La API key de OpenRouter
# YA NO va aquí: se crea la credencial dentro del editor de n8n (http://localhost:5678).
# Estas variables solo conectan backend <-> n8n (ver n8n/README.md):
# Secreto del header X-Chat-Secret con el que el backend autentica el webhook de n8n.
N8N_CHAT_SECRET=SECRETO_COMPARTIDO_BACKEND_N8N
# Token X-Service-Token con el que n8n consume /api/productos/buscar (herramientas del agente).
# Obligatorio: si está vacío, el backend rechaza la herramienta (403) y el chat no encuentra productos.
N8N_TOOLS_SECRET=SECRETO_PARA_HERRAMIENTAS_N8N
# Opcional: versión fija de la imagen de n8n en docker-compose.yml (vacía = latest).
# N8N_VERSION=
# Solo si n8n NO está en el mismo docker-compose (con compose se usa http://n8n:5678/...):
# N8N_WEBHOOK_URL=http://n8n:5678/webhook/chat-drivemaster
# Contraseña del PostgreSQL local con la memoria del chat (servicio chat-memory). Se usa también en la
# credencial Postgres de n8n (host chat-memory, puerto 5432, base chat_memory, usuario n8n, sin SSL).
CHAT_MEMORY_DB_PASSWORD=SECRETO_MEMORIA_CHAT
# Opcional: modelo de OpenRouter (por defecto anthropic/claude-haiku-5.5; debe soportar herramientas).
# OPENROUTER_MODEL=anthropic/claude-haiku-5.5
# Opcional: topes del chat (cada mensaje cuesta tokens). Por minuto por IP, por día por IP,
# por día en total (acota el gasto diario) y largo máximo del mensaje.
# N8N_CHAT_RATE_MAX=6
# N8N_CHAT_RATE_DIA_IP=60
# N8N_CHAT_RATE_DIA_GLOBAL=400
# N8N_CHAT_MAX_CARACTERES=500

# ── Cloudinary ──
CLOUDINARY_CLOUD_NAME=tu-cloud
CLOUDINARY_API_KEY=tu-key
CLOUDINARY_API_SECRET=tu-secret

# ── Google (inicio de sesión) ──
# GOOGLE_CLIENT_ID (backend) y VITE_GOOGLE_CLIENT_ID (frontend) deben ser el mismo. Sin ellos el backend arranca
# igual y solo falla el botón de Google; el frontend usa el client-id que ya traía el código.
GOOGLE_CLIENT_ID=tu-client-id.apps.googleusercontent.com
VITE_GOOGLE_CLIENT_ID=tu-client-id.apps.googleusercontent.com

# ── Wompi ──
# Sandbox:  https://sandbox.wompi.co/v1   pub_test_... / test_integrity_...
# Produccion: https://production.wompi.co/v1   pub_prod_... / prod_integrity_...
WOMPI_PUBLIC_KEY=pub_test_TU_KEY
WOMPI_INTEGRITY_KEY=test_integrity_TU_KEY
WOMPI_API_URL=https://sandbox.wompi.co/v1
# En produccion apunta al backend en Render (no a Vercel):
WOMPI_REDIRECT_URL=https://TU-BACKEND.onrender.com/api/pagos/confirmar-redirect

# ── Frontend (Vercel) ──
# FRONTEND_URL (backend): dominio del frontend. Tras verificar un pago, /api/pagos/confirmar-redirect
# devuelve al cliente a FRONTEND_URL + "/?pago=resultado&id=...". Va SIN "/" al final (si no, queda "//").
# También se suma a los orígenes permitidos de CORS y del WebSocket. Sin ella el backend arranca con
# http://localhost:5173, que solo sirve en local: defínela siempre en cada despliegue.
FRONTEND_URL=https://TU-FRONTEND.vercel.app
VITE_API_URL=https://TU-BACKEND.onrender.com
# VITE_WOMPI_REDIRECT_URL (frontend, opcional): a dónde manda Wompi al cliente al terminar de pagar
# las solicitudes y ventas. Debe apuntar al BACKEND (confirmar-redirect verifica el pago y luego lo
# lleva a FRONTEND_URL), no a Vercel. Si no se define, se usa VITE_API_URL + /api/pagos/confirmar-redirect.
# Los pagos del marketplace usan WOMPI_REDIRECT_URL del backend.
VITE_WOMPI_REDIRECT_URL=https://TU-BACKEND.onrender.com/api/pagos/confirmar-redirect

# ── Mapas (todo opcional y gratuito, sin API key) ──
# Vacías = servicios públicos: teselas estándar de OpenStreetMap (en tema oscuro se oscurecen con CSS), autocompletado con Photon
# (photon.komoot.io), dirección de un punto con Nominatim (máx. 1 petición/s) y rutas con OSRM
# (router.project-osrm.org). Se cambian para usar servidores propios, p. ej. en el HomeLab.
# VITE_MAP_TILES_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# VITE_MAP_TILES_ATTRIBUTION=&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors
# VITE_PHOTON_URL=https://photon.komoot.io
# VITE_NOMINATIM_URL=https://nominatim.openstreetmap.org
# Correo de contacto que se envía a Nominatim (su política lo pide si el uso crece)
# VITE_NOMINATIM_EMAIL=
# VITE_OSRM_URL=https://router.project-osrm.org
# OSRM_URL (backend): tiempo en carro de los 3 talleres más cercanos al pedir un diagnóstico.
# OSRM_URL=https://router.project-osrm.org

# ── Datos demo: solo en desarrollo local (true). En Render/producción no definir.
DEMO_SEED_ENABLED=false

# ── Pago simulado: solo desarrollo local (true) y con llaves pub_test_. En Render/producción no definir.
PAGO_SIMULADO_ENABLED=false

# ── Verificación manual del pago ("Ya pagué, verificar mi pago"): solo desarrollo local ──
# Solo se muestra con esta variable en true, llaves pub_test_ y sin redirect-url (localhost).
# En Render/producción no definir.
PAGO_VERIFICACION_MANUAL_ENABLED=false

# ── Dispersión (liquidación a talleres y tiendas) ──
# SIMULADO (por defecto): automática, referencias SIM-…; el backend NO arranca así con llaves reales.
# MANUAL (producción): el ADMIN transfiere por el banco y anota el número de transferencia.
DISPERSION_MODO=SIMULADO

# ── Tareas de fondo (varios servidores con la misma base) ──
# Si otro servidor (p. ej. el HomeLab) usa la misma base, solo UNO debe ejecutar las tareas programadas y la
# migración de arranque: true (por defecto) en ese, false en el resto. Con un solo servidor, no definirla.
# TAREAS_PROGRAMADAS_ENABLED=true
