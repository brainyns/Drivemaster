# Variables del stack de DriveMaster.
#
# Con Portainer: Stacks → Add stack → Environment variables → "Advanced mode", pega este contenido
# y completa los valores ahí. No crees un .env en el repositorio ni lo subas a Git.
# Sin Portainer: cp .env.example .env && chmod 600 .env, y llénalo en la VM.
#
# Para generar contraseñas y secretos aleatorios:   openssl rand -hex 32
# (solo letras y números: evita "$" en los valores, Compose lo interpreta como variable)

# ── Dominio público (Cloudflare Tunnel) ──
# Sin "/" al final. Debe coincidir con el "Public hostname" que configures en Cloudflare.
PUBLIC_URL=https://drivemaster.TUDOMINIO.com
FRONTEND_URL=https://drivemaster.TUDOMINIO.com
# Token del túnel (Cloudflare Zero Trust → Networks → Tunnels → tu túnel → "Install connector").
CLOUDFLARE_TUNNEL_TOKEN=

# Puerto de la VM para probar desde tu red local: http://IP-DE-LA-VM:8088
LAN_PORT=8088

# ── Bases de datos en la nube: copia los MISMOS valores que tenías en Render ──
# MongoDB Atlas (mongodb+srv://usuario:clave@cluster.xxxxx.mongodb.net/drivemasterDB?...)
SPRING_DATA_MONGODB_URI=
# Supabase (jdbc:postgresql://...pooler.supabase.com:5432/postgres?...). Usa el "Session pooler":
# la conexión directa de Supabase es solo IPv6.
DB_URL=
DB_USERNAME=
DB_PASSWORD=

# ── JWT (mínimo 32 caracteres) ──
# Si el HomeLab reemplaza a Render, usa el MISMO valor que Render: así nadie pierde la sesión.
SECURITY_JWT_SECRET=CAMBIAR_openssl_rand_hex_32

# ── Código de retiro (HMAC). Obligatorio con llaves reales de Wompi ──
# Igual que el JWT: copia el de Render, o los códigos de retiro ya emitidos dejan de validar.
RETIRO_CODIGO_SECRET=CAMBIAR_openssl_rand_hex_32

# ── Correo (Brevo) ──
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=DriveMaster

# ── n8n (chat IA) ──
# La API key de OpenRouter NO va en el backend: se crea la credencial dentro del editor de n8n
# (en la VM: ssh -L 5678:localhost:5678 ... y abrir http://localhost:5678; importar
# n8n/workflows/chat-drivemaster.json). Estas variables solo comparten secretos backend <-> n8n.
# Obligatorios: sin ellos el stack no se despliega.
N8N_CHAT_SECRET=CAMBIAR_openssl_rand_hex_32
N8N_TOOLS_SECRET=CAMBIAR_openssl_rand_hex_32
# Contraseña del PostgreSQL local con la memoria del chat (servicio chat-memory). Obligatoria. La misma
# va en la credencial Postgres de n8n (host chat-memory, puerto 5432, base chat_memory, usuario n8n, sin SSL).
CHAT_MEMORY_DB_PASSWORD=CAMBIAR_openssl_rand_hex_32
# Versión de la imagen de n8n. Pon exactamente la que ya corre (n8n → Settings → About, o
# docker exec drivemaster-n8n-1 n8n --version); vacía = latest. Nunca pongas una versión anterior:
# n8n no puede volver atrás la base de datos del volumen.
N8N_VERSION=
# Modelo de OpenRouter (debe soportar herramientas / tool use).
OPENROUTER_MODEL=anthropic/claude-haiku-5.5
# Topes del chat (cada mensaje cuesta tokens): por minuto por IP, por día por IP y por día en
# total. El global acota el gasto máximo diario.
N8N_CHAT_RATE_MAX=6
N8N_CHAT_RATE_DIA_IP=60
N8N_CHAT_RATE_DIA_GLOBAL=400

# ── Cloudinary (imágenes) ──
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Google (inicio de sesión) ──
# En Google Cloud Console agrega PUBLIC_URL como "Origen de JavaScript autorizado".
# Se usa en el backend y en el build del frontend. Vacío: el backend arranca y solo falla el botón de Google.
GOOGLE_CLIENT_ID=

# ── Marca ──
# URL https del logo para los correos y el PDF. Vacía = el nombre "DriveMaster" en texto.
BRAND_LOGO_URL=

# ── Wompi ──
# Empieza en sandbox. Con llaves pub_test_ el backend acepta DISPERSION_MODO=SIMULADO.
WOMPI_PUBLIC_KEY=pub_test_
WOMPI_INTEGRITY_KEY=test_integrity_
WOMPI_API_URL=https://sandbox.wompi.co/v1
WOMPI_REDIRECT_URL=https://drivemaster.TUDOMINIO.com/api/pagos/confirmar-redirect
DISPERSION_MODO=SIMULADO

# ── Solo desarrollo: dejar en false en el HomeLab publicado ──
DEMO_SEED_ENABLED=false
PAGO_SIMULADO_ENABLED=false
PAGO_VERIFICACION_MANUAL_ENABLED=false
MAIL_DEV_LOG=false
MAIL_DEV_SKIP_SEND=false

# ── Tareas de fondo ──
# Render y el HomeLab comparten la base: solo uno debe ejecutar las tareas programadas (si no, los
# recordatorios de mantenimiento salen dos veces). false = las ejecuta Render. Ponla en true aquí
# SOLO si en Render pones TAREAS_PROGRAMADAS_ENABLED=false (o Render está apagado).
TAREAS_PROGRAMADAS_ENABLED=false
